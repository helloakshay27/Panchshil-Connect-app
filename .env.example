# FM Adoption analytics API (PostHog-backed). This is called directly by the
# browser, so it is visible in DevTools Network as the upstream API host.
VITE_FM_ADOPTION_API_URL=https://posthog-api.lockated.com

# The `url` query param tenant is the FRONTEND host serving the app (the
# analytics tenant), resolved by src/config/fmAdoptionTenant.js — never the
# backend API URL and never a hardcoded tenant. Locally/unmapped it resolves to
# the Panchshil UAT frontend (uat-connect.panchshil.com). Only set this to force
# a specific tenant per deployment; normally leave it blank/unset.
# (Backend API config lives in src/pages/baseurl/apiDomain.js.)
# VITE_FM_ADOPTION_TENANT_URL=uat-connect.panchshil.com
