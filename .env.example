# FM Adoption analytics API (PostHog-backed). This is called directly by the
# browser, so it is visible in DevTools Network as the upstream API host.
VITE_FM_ADOPTION_API_URL=https://posthog-api.lockated.com

# Analytics tenant host, sent as the `url` query param. UAT tenant by default;
# prod = pulse.panchshil.com
VITE_FM_ADOPTION_TENANT_URL=pulse-uat.panchshil.com
